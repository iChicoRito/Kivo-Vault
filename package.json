{
  "name": "kivo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "landing:dev": "vite --config vite.landing.config.ts",
    "landing:build": "vite build --config vite.landing.config.ts",
    "landing:preview": "vite preview --config vite.landing.config.ts",
    "video:dev": "node video/sounds.mjs && remotion studio video/index.ts --public-dir video/public",
    "video:render": "node video/sounds.mjs && remotion render video/index.ts KivoPromo video/out/kivo-promo.mp4 --public-dir video/public"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@heroui/react": "^3.2.5",
    "@heroui/styles": "^3.2.5",
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@thesvg/react": "^3.3.8",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.46.0",
    "matter-js": "^0.20.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "thesvg": "^3.3.8"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "remotion": "4.0.529",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
